# BusPlus Environment Configuration
# Copy this file to .env and adjust values

# Database
DATABASE_URL=sqlite:///./busplus.db
# For Docker/Production:
# DATABASE_URL=postgresql://busplus:busplus123@localhost:5432/busplus

# Security
SECRET_KEY=busplus-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# AI Configuration
MOCK_AI=true
MODEL_PATH=ai/models/best.pt
FRAME_SKIP=5
CONFIDENCE_THRESHOLD=0.5

# Verification
ISSUE_CLUSTER_RADIUS_METERS=20

# Backend
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend
VITE_API_URL=http://localhost:8000
